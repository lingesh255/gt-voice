# Fill these in, then run: python main.py --check

# Language model. Gemini has a free tier: create a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_THINKING_LEVEL=low

# Or any OpenAI-compatible endpoint (OpenAI, Groq, a local server):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Indian-language speech (Sarvam AI). Leave empty to use the browser's own speech in Chrome or Edge.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh

# Optional: also POST confirmed orders to this URL (try http://127.0.0.1:8000/api/oms/orders)
OMS_WEBHOOK_URL=
